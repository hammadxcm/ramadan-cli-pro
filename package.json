{
	"name": "ramadan-cli-pro",
	"version": "1.3.2",
	"description": "Professional-grade Ramadan prayer times CLI with TUI dashboard, i18n, caching, and notifications",
	"type": "module",
	"bin": {
		"ramadan-cli-pro": "./dist/cli.js",
		"ramadan-pro": "./dist/cli.js",
		"ramadan": "./dist/cli.js",
		"ramzan": "./dist/cli.js",
		"roza": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"start": "node dist/cli.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"keywords": [
		"ramadan",
		"prayer-times",
		"sehar",
		"iftar",
		"hijri",
		"cli",
		"tui",
		"dashboard"
	],
	"author": "Hammad Khan (https://x.com/hammadkhanxcm)",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/update-notifier": "^6.0.8",
		"@vitest/coverage-v8": "^4.1.12",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.4",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@clack/prompts": "^0.10.1",
		"commander": "^13.1.0",
		"conf": "^13.1.0",
		"i18next": "^24.2.3",
		"ink": "^5.2.1",
		"node-notifier": "^10.0.1",
		"ora": "^8.2.0",
		"picocolors": "^1.1.1",
		"react": "^18.3.1",
		"string-width": "^8.3.0",
		"update-notifier": "^7.3.1",
		"zod": "^3.25.76"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.5.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild"
		],
		"overrides": {
			"node-notifier>uuid": "^11.1.1",
			"esbuild@<0.28.1": "^0.28.1"
		}
	}
}
